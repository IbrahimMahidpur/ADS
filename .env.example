# OpenCode Zen - get your API key from https://opencode.ai
OPENCODE_ZEN_API_KEY=your_opencode_api_key_here

# Model routing — these override config.py defaults
PLANNER_MODEL=opencode/minimax-m2.5-free
CODER_MODEL=opencode/minimax-m2.5-free
REVIEWER_MODEL=opencode/minimax-m2.5-free
CODE_GEN_MODEL=opencode/minimax-m2.5-free
CODE_FIX_MODEL=ollama/qwen2.5-coder:7b
HYPOTHESIS_MODEL=opencode/minimax-m2.5-free
STATS_INTERPRETER_MODEL=ollama/qwen2.5:7b
VISION_MODEL=ollama/llava:7b
EMBED_MODEL=ollama/mxbai-embed-large

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Timeouts
LLM_TIMEOUT=120
PLANNER_TIMEOUT=60